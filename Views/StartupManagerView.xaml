<UserControl x:Class="WinCareDesktop.Views.StartupManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WinCareDesktop.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900">
    <Grid Margin="0,0,10,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ══ TOP BAR, FILTER & REFRESH ═════════════════════════════ -->
        <Border Grid.Row="0" Style="{DynamicResource Card}" Padding="16" Margin="0,0,0,14">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4" />
                        <TextBlock Text="Disabling unneeded high-impact startup programs cuts Windows login delay and prevents background apps from holding hundreds of MBs of RAM idle."
                                   FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource PrimaryLight}" CornerRadius="6" Padding="10,6" Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ImpactSummary}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Primary}" />
                        </Border>
                        <Button Command="{Binding RefreshCommand}"
                                AutomationProperties.Name="Refresh startup applications"
                                Padding="14,8" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="{DynamicResource IconFont}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Refresh" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10,7" FontSize="12" Margin="0,12,0,0"
                         Background="{DynamicResource SurfaceHover}" BorderBrush="{DynamicResource Hairline}"
                         AutomationProperties.Name="Filter startup programs"
                         ToolTip="Filter startup entries by name, command, impact, or registry location" />
            </StackPanel>
        </Border>

        <!-- ══ STARTUP ENTRIES LIST ══════════════════════════════════ -->
        <Border Grid.Row="1" Style="{DynamicResource Card}" Padding="0">
            <ListBox ItemsSource="{Binding DisplayedEntries}" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,1" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="16,12"
                                            BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Hairline}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHover}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="105" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>

                            <!-- Name & Command -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                           Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="{Binding Command}" FontSize="11"
                                           Foreground="{DynamicResource TextTertiary}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- Location Badge -->
                            <Border Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left"
                                    Background="{DynamicResource SurfaceHover}" CornerRadius="4" Padding="6,3">
                                <TextBlock Text="{Binding Location}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                            </Border>

                            <!-- Impact Pill -->
                            <Border Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left"
                                    Background="{DynamicResource SurfaceHover}" CornerRadius="4" Padding="8,3">
                                <TextBlock Text="{Binding Impact, StringFormat={}Impact: {0}}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Warning}" />
                            </Border>

                            <!-- Toggle Status Button -->
                            <Button Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right"
                                    AutomationProperties.Name="{Binding Name, StringFormat=Toggle startup item {0}}"
                                    Command="{Binding DataContext.ToggleItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Padding="12,6">
                                <TextBlock Text="{Binding IsEnabled, Converter={x:Static vm:BooleanToEnabledTextConverter.Instance}}"
                                           FontWeight="SemiBold" FontSize="12" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
