<UserControl x:Class="WinCareDesktop.Views.OptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,10,24">
            <Border Style="{DynamicResource Card}" Padding="20">
                <StackPanel>
                    <TextBlock Text="Keep WinCare lightweight" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Text="Live header refresh interval (seconds)" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding RefreshIntervals}"
                              SelectedItem="{Binding RefreshSeconds}"
                              Width="140"
                              HorizontalAlignment="Left"
                              Margin="0,0,0,14"
                              AutomationProperties.Name="Live telemetry refresh seconds" />
                    <TextBlock Text="Memory and Defender reads remain manual. Slower refresh reduces how often WinCare reads live header measurements; it does not promise a faster PC."
                               Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock Text="Reduced motion: static interface, no animated transitions." />
                    <CheckBox Content="Full Obsidian Dark Deck (dark space-cockpit instrument cards)"
                              IsChecked="{Binding DarkDeck}"
                              AutomationProperties.Name="Enable Full Obsidian Dark Deck workspace theme"
                              Margin="0,2,0,10"
                              FontSize="13" />
                    <CheckBox Content="Allow future local environment and crash diagnostic files"
                              IsChecked="{Binding LocalDiagnostics}"
                              AutomationProperties.Name="Allow future local environment and crash diagnostic files"
                              Margin="0,4,0,12"
                              FontSize="13" />
                    <TextBlock Text="Off by default. Diagnostic files can include machine details and exception text; nothing is uploaded. This controls future environment/crash files, not existing files, required recovery history or manually previewed exports. Restart to generate a newly enabled environment report."
                               Foreground="{DynamicResource TextSecondary}" />
                    <WrapPanel Margin="0,0,0,4">
                        <Button Style="{DynamicResource PrimaryButton}"
                                Content="Save app preferences"
                                AutomationProperties.Name="Save app preferences"
                                Command="{Binding SaveCommand}"
                                IsEnabled="{Binding CanSave}"
                                Padding="16,9" Margin="0,0,10,10" />
                        <Button Content="Reset app preferences only"
                                AutomationProperties.Name="Reset app preferences only"
                                Command="{Binding ResetCommand}"
                                IsEnabled="{Binding CanSave}"
                                Padding="14,9" Margin="0,0,10,10" />
                    </WrapPanel>
                    <TextBlock Text="{Binding Status}" AutomationProperties.LiveSetting="Polite" Margin="0" />
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource Card}" Padding="20" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Offline Pro License Activation" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Text="100% offline ECDSA cryptographic verification — WinCare Pro never contacts an activation server or phones home."
                               Foreground="{DynamicResource TextSecondary}" />
                    <TextBox x:Name="LicenseKeyTextBox"
                             Text="{Binding LicenseKeyInput, UpdateSourceTrigger=PropertyChanged}"
                             Padding="10,8" FontSize="12"
                             FontFamily="{DynamicResource MonoFont}"
                             Background="{DynamicResource SurfaceHover}"
                             BorderBrush="{DynamicResource Hairline}"
                             AutomationProperties.Name="WinCare Pro offline license key"
                             ToolTip="Paste your WCP2. license key"
                             Margin="0,0,0,10" />
                    <WrapPanel Margin="0,0,0,4">
                        <Button Style="{DynamicResource PrimaryButton}"
                                Content="Activate License Key"
                                AutomationProperties.Name="Activate offline license key"
                                Command="{Binding ActivateLicenseCommand}"
                                IsEnabled="{Binding CanSave}"
                                Padding="16,9" Margin="0,0,10,10" />
                        <Button Content="Remove Local License"
                                AutomationProperties.Name="Remove local license from this PC"
                                Command="{Binding DeactivateLicenseCommand}"
                                IsEnabled="{Binding CanSave}"
                                Padding="14,9" Margin="0,0,10,10" />
                    </WrapPanel>
                    <TextBlock Text="{Binding LicenseStatus}"
                               Foreground="{DynamicResource Primary}"
                               FontWeight="SemiBold"
                               AutomationProperties.LiveSetting="Polite"
                               Margin="0" />
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource Card}" Padding="20" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Safety is not optional" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Text="Critical confirmations cannot be disabled. Saving or resetting preferences never changes Windows protection, exclusions, startup, services or scheduled cleanup. No login task or background service is enabled. Safe mode blocks preference writes and all rescue actions."
                               Foreground="{DynamicResource TextSecondary}" Margin="0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
