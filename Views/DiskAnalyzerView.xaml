<UserControl x:Class="WinCareDesktop.Views.DiskAnalyzerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WinCareDesktop.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900">
    <Grid Margin="0,0,10,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ══ TOP BAR & QUICK PATHS ═════════════════════════════════ -->
        <Border Grid.Row="0" Style="{DynamicResource Card}" Padding="16" Margin="0,0,0,14">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Target Directory to Analyze:" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding CurrentPath, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Target directory to analyze"
                                 Padding="10,8" FontSize="13" Background="{DynamicResource SurfaceHover}"
                                 BorderBrush="{DynamicResource Hairline}" Margin="0,0,16,0" />
                    </StackPanel>

                    <!-- Actions -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Style="{DynamicResource PrimaryButton}"
                                AutomationProperties.Name="Scan directory space"
                                Command="{Binding StartScanCommand}"
                                IsEnabled="{Binding IsScanning, Converter={x:Static vm:InverseBooleanConverter.Instance}}"
                                Padding="16,8" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE721;" FontFamily="{DynamicResource IconFont}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Scan Space" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Content="Cancel" Command="{Binding CancelScanCommand}"
                                IsEnabled="{Binding IsScanning}" Padding="14,8" />
                    </StackPanel>
                </Grid>

                <!-- Quick Folder Jumps & Read-Only Cache Probe -->
                <WrapPanel Margin="0,12,0,4">
                    <Button Content="User Profile" Command="{Binding SelectQuickTargetCommand}" CommandParameter="Profile"
                            IsEnabled="{Binding IsScanning, Converter={x:Static vm:InverseBooleanConverter.Instance}}"
                            Padding="10,5" Margin="0,0,8,6" />
                    <Button Content="Downloads" Command="{Binding SelectQuickTargetCommand}" CommandParameter="Downloads"
                            IsEnabled="{Binding IsScanning, Converter={x:Static vm:InverseBooleanConverter.Instance}}"
                            Padding="10,5" Margin="0,0,8,6" />
                    <Button Content="Temp Folder" Command="{Binding SelectQuickTargetCommand}" CommandParameter="Temp"
                            IsEnabled="{Binding IsScanning, Converter={x:Static vm:InverseBooleanConverter.Instance}}"
                            Padding="10,5" Margin="0,0,8,6" />
                    <Button Content="LocalAppData" Command="{Binding SelectQuickTargetCommand}" CommandParameter="LocalAppData"
                            IsEnabled="{Binding IsScanning, Converter={x:Static vm:InverseBooleanConverter.Instance}}"
                            Padding="10,5" Margin="0,0,12,6" />
                    <Button Content="Scan Deep Safe Caches"
                            AutomationProperties.Name="Scan browser, shader, crash, and temp caches"
                            Command="{Binding MeasureSystemCachesCommand}"
                            IsEnabled="{Binding IsMeasuringCaches, Converter={x:Static vm:InverseBooleanConverter.Instance}}"
                            Padding="10,5" Margin="0,0,8,6" />
                    <Button Style="{DynamicResource PrimaryButton}"
                            Content="Clean Previewed Caches…"
                            AutomationProperties.Name="Clean previewed safe caches"
                            Command="{Binding CleanSafeCachesCommand}"
                            IsEnabled="{Binding CanCleanSafeCaches}"
                            Padding="12,5" FontSize="12" Margin="0,0,8,6" />
                    <Button Content="Find Duplicates (≥ 1 MB)"
                            AutomationProperties.Name="Scan target directory for exact SHA-256 duplicate files"
                            Command="{Binding ScanDuplicatesCommand}"
                            IsEnabled="{Binding IsScanningDuplicates, Converter={x:Static vm:InverseBooleanConverter.Instance}}"
                            Padding="10,5" Margin="0,0,8,6" />
                </WrapPanel>
                <TextBlock Text="{Binding SystemCacheSummary}" FontSize="11"
                           Foreground="{DynamicResource TextTertiary}" TextWrapping="Wrap" />

                <ItemsControl ItemsSource="{Binding DuplicateGroups}"
                              Visibility="{Binding HasDuplicateResults, Converter={x:Static vm:BoolToVisibilityConverter.Instance}, FallbackValue=Collapsed}"
                              Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceHover}" CornerRadius="6" Padding="12,8" Margin="0,0,0,6"
                                    BorderBrush="{DynamicResource Hairline}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding PrimaryFileName, StringFormat={}Exact SHA-256 Duplicate: {0}}"
                                                   FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock Text="{Binding ExtraFilePath, StringFormat={}Extra copy: {0}}"
                                                   FontSize="11" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FormattedReclaimable, StringFormat={}+{0}}"
                                                   FontFamily="{DynamicResource MonoFont}" FontSize="11.5" FontWeight="Bold"
                                                   Foreground="{DynamicResource Primary}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <Button Content="Recycle Extra Copy…"
                                                AutomationProperties.Name="{Binding PrimaryFileName, StringFormat=Move duplicate copy of {0} to Recycle Bin}"
                                                Command="{Binding DataContext.RecycleDuplicateExtraCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="10,4" FontSize="11" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ══ STATUS & SUMMARY ═════════════════════════════════════ -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceHover}" CornerRadius="8"
                Padding="12,8" Margin="0,0,0,12" BorderBrush="{DynamicResource Hairline}" BorderThickness="1">
            <Grid>
                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
                <ProgressBar IsIndeterminate="True" Height="4" Width="100" HorizontalAlignment="Right"
                             Foreground="{DynamicResource Primary}"
                             Visibility="{Binding IsScanning, Converter={x:Static vm:BoolToVisibilityConverter.Instance}, FallbackValue=Collapsed}" />
            </Grid>
        </Border>

        <!-- ══ INTERACTIVE RESULTS LIST ═════════════════════════════ -->
        <Border Grid.Row="2" Style="{DynamicResource Card}" Padding="0">
            <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                     Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,2" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="16,12"
                                            BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Hairline}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryLight}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Category Badge -->
                            <Border Grid.Column="0" Background="{DynamicResource SurfaceHover}" CornerRadius="4"
                                     Padding="8,4" Margin="0,0,14,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondary}" />
                            </Border>

                            <!-- Name & Path -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                           Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding FullPath}" FontSize="11"
                                           Foreground="{DynamicResource TextTertiary}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- Percentage & Size -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="{Binding FormattedSize}" FontWeight="Bold"
                                               FontFamily="{DynamicResource MonoFont}" FontSize="12"
                                               Foreground="{DynamicResource Primary}" />
                                    <TextBlock Text="{Binding PercentageOfParent, StringFormat={}{0:F1}%}"
                                               HorizontalAlignment="Right" FontSize="11"
                                               Foreground="{DynamicResource TextTertiary}" />
                                </Grid>
                                <ProgressBar Height="4" Maximum="100" Value="{Binding PercentageOfParent}"
                                             Foreground="{DynamicResource Primary}" Background="{DynamicResource Hairline}"
                                             BorderThickness="0" />
                            </StackPanel>

                            <!-- Row Action Buttons -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button ToolTip="Open Location"
                                        AutomationProperties.Name="Open in Explorer"
                                        Command="{Binding DataContext.OpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Padding="8,5" Margin="0,0,6,0">
                                    <TextBlock Text="&#xE8B7;" FontFamily="{DynamicResource IconFont}" FontSize="13" />
                                </Button>
                                <Button ToolTip="Review and move to Recycle Bin"
                                        AutomationProperties.Name="Review and move to Recycle Bin"
                                        Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Padding="8,5" Foreground="{DynamicResource Error}">
                                    <TextBlock Text="&#xE74D;" FontFamily="{DynamicResource IconFont}" FontSize="13" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
