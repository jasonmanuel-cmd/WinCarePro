<UserControl x:Class="WinCareDesktop.Views.AppUninstallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WinCareDesktop.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">
    <Grid Margin="0,0,10,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ══ TOP BAR & SEARCH ══════════════════════════════════════ -->
        <Border Grid.Row="0" Style="{DynamicResource Card}" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Filter Installed Programs:" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                             Padding="10,8" FontSize="13" Background="{DynamicResource SurfaceHover}"
                             BorderBrush="{DynamicResource Hairline}" Margin="0,0,16,0" />
                </StackPanel>

                <!-- Batch Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Select All" Command="{Binding SelectAllCommand}"
                            CommandParameter="{x:Static vm:BooleanBoxes.TrueBox}"
                            Padding="12,8" Margin="0,0,8,0" />
                    <Button Content="Deselect All" Command="{Binding SelectAllCommand}"
                            CommandParameter="{x:Static vm:BooleanBoxes.FalseBox}"
                            Padding="12,8" Margin="0,0,12,0" />

                    <!-- Uninstall Selected Button -->
                    <Button Content="{Binding SelectedCount, StringFormat={}🗑️ Uninstall Selected ({0})}"
                            Command="{Binding UninstallSelectedCommand}"
                            IsEnabled="{Binding SelectedCount, Converter={x:Static vm:IntGreaterThanZeroConverter.Instance}}"
                            Background="{DynamicResource Error}" Foreground="White"
                            BorderThickness="0" FontWeight="SemiBold" Padding="16,8" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ STATUS BAR ════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceHover}" CornerRadius="8"
                Padding="12,8" Margin="0,0,0,12" BorderBrush="{DynamicResource Hairline}" BorderThickness="1">
            <Grid>
                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Center" />
                <ProgressBar IsIndeterminate="True" Height="4" Width="100" HorizontalAlignment="Right"
                             Foreground="{DynamicResource Primary}"
                             Visibility="{Binding IsLoading, Converter={x:Static vm:BoolToVisibilityConverter.Instance}, FallbackValue=Collapsed}" />
            </Grid>
        </Border>

        <!-- ══ APPS LIST ═════════════════════════════════════════════ -->
        <Border Grid.Row="2" Style="{DynamicResource Card}" Padding="0">
            <ListBox ItemsSource="{Binding DisplayedApps}" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,1" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="16,10"
                                            BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Hairline}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHover}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>

                            <!-- Checkbox -->
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,16,0" />

                            <!-- Name & Publisher -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                           Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Publisher}" FontSize="11"
                                           Foreground="{DynamicResource TextTertiary}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- Type Badge -->
                            <Border Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left"
                                    Background="{DynamicResource SurfaceHover}" CornerRadius="4" Padding="8,4">
                                <TextBlock Text="{Binding TypeBadge}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                            </Border>

                            <!-- Size -->
                            <TextBlock Grid.Column="3" Text="{Binding SizeText}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                       FontFamily="{DynamicResource MonoFont}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Primary}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
