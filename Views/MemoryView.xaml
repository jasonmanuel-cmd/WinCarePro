<UserControl x:Class="WinCareDesktop.Views.MemoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WinCareDesktop.ViewModels">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,10,24">
            <Border Style="{DynamicResource Card}" Padding="20">
                <StackPanel>
                    <TextBlock Text="Know what is using your RAM &amp; CPU" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding Summary}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Primary}" />
                    <WrapPanel Margin="0,0,0,4">
                        <Button x:Name="SampleMemoryButton"
                                Style="{DynamicResource PrimaryButton}"
                                Content="Sample memory &amp; CPU"
                                Command="{Binding RefreshCommand}"
                                AutomationProperties.Name="Sample memory and CPU"
                                Padding="16,9" Margin="0,0,10,10" />
                        <Button Content="Cancel reading"
                                Command="{Binding CancelCommand}"
                                IsEnabled="{Binding Busy}"
                                Padding="14,9" Margin="0,0,10,10" />
                        <Button Content="Trim WinCare Memory"
                                Command="{Binding TrimWinCareRamCommand}"
                                Padding="14,9" Margin="0,0,10,10" />
                        <Button Content="Manage Startup Apps"
                                Command="{Binding OpenStartupAppsCommand}"
                                Padding="14,9" Margin="0,0,10,10" />
                        <Button Content="Remove Unused Apps"
                                Command="{Binding OpenAppRemoverCommand}"
                                Padding="14,9" Margin="0,0,10,10" />
                    </WrapPanel>
                    <TextBlock Text="{Binding Status}" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="A large working set is not proof an app is unnecessary. Shared memory can appear in multiple processes; do not add these values. Process names and PIDs are observations, not trusted identity or ownership."
                               Foreground="{DynamicResource TextSecondary}" Margin="0" />
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource Card}" Padding="20" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Review before closing anything" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Text="Save your work, then close an optional app from its own window or use confirmed graceful close below. Preserve Windows, security, sync, remote access, accessibility and agent tools. If you do not recognize an app, leave it running. Review future launches in Startup Apps; changes there do not close running apps."
                               Foreground="{DynamicResource TextSecondary}" />
                    <WrapPanel Margin="0,0,0,4">
                        <Button Style="{DynamicResource PrimaryButton}"
                                Content="Review eligible optional apps"
                                Command="{Binding ReviewAppsCommand}"
                                Padding="16,9" Margin="0,0,10,10" />
                        <Button Content="Cancel app review"
                                Command="{Binding CancelAppReviewCommand}"
                                IsEnabled="{Binding AppBusy}"
                                Padding="14,9" Margin="0,0,10,10" />
                    </WrapPanel>
                    <TextBlock Text="{Binding AppStatus}" AutomationProperties.LiveSetting="Polite" />
                    <ItemsControl ItemsSource="{Binding OptionalApps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0" Padding="0,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8" />
                                        <Button Content="Close this app…"
                                                AutomationProperties.Name="{Binding Name, StringFormat=Close {0}}"
                                                HorizontalAlignment="Left"
                                                Command="{Binding DataContext.CloseAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding DataContext.CanCloseApps, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Padding="14,8" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Only Authenticode-verified VLC, Spotify, Discord, Steam, or Epic Games Launcher windows in your user session can qualify. Each request reconfirms identity and asks you first. All other processes remain manual. No force, process trees, RAM flushing or automatic closing. Closing is not automatically reversible."
                               Foreground="{DynamicResource TextSecondary}" />

                    <Grid Margin="0,6,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Resource observations — not close targets" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0" />
                        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                     Width="160" Padding="8,5" FontSize="12"
                                     Background="{DynamicResource SurfaceHover}" BorderBrush="{DynamicResource Hairline}"
                                     AutomationProperties.Name="Filter observed processes"
                                     ToolTip="Filter by process name, PID, or role" Margin="0,0,8,0" />
                            <Button Content="Sort by RAM" Command="{Binding SortByRamCommand}" Padding="10,5" Margin="0,0,6,0" />
                            <Button Content="Sort by CPU" Command="{Binding SortByCpuLoadCommand}" Padding="10,5" />
                        </WrapPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding DisplayedRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0" />
                                            <TextBlock Text="{Binding IdentityText}" FontSize="12" Margin="0" Foreground="{DynamicResource TextSecondary}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding MemoryMb, StringFormat={}{0:F1} MB}" FontFamily="{DynamicResource MonoFont}" Margin="0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding CpuText, StringFormat=CPU {0}}" FontFamily="{DynamicResource MonoFont}" Margin="0" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
