<UserControl x:Class="WinCareDesktop.Views.DefenderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WinCareDesktop.ViewModels">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,10,24">
            <Border Style="{DynamicResource Card}" Padding="20">
                <StackPanel>
                    <TextBlock Text="Microsoft Defender protection" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding Protection}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Primary}" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding Signatures}" Foreground="{DynamicResource TextSecondary}" />
                    <WrapPanel Margin="0,0,0,4">
                        <Button Style="{DynamicResource PrimaryButton}"
                                Content="Read protection status"
                                Command="{Binding RefreshCommand}"
                                AutomationProperties.Name="Read Defender protection status"
                                Padding="16,9" Margin="0,0,10,10" />
                        <Button Content="Cancel reading"
                                AutomationProperties.Name="Cancel Defender status reading"
                                Command="{Binding CancelCommand}"
                                IsEnabled="{Binding Busy}"
                                Padding="14,9" Margin="0,0,10,10" />
                    </WrapPanel>
                    <TextBlock Text="{Binding Status}" AutomationProperties.LiveSetting="Polite" Margin="0" />
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource Card}" Padding="20" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Start a confirmed Defender scan" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Text="Read status first. Normal active Defender and accessible event history are required. Full scans can use significant CPU and disk time. Defender may quarantine or remove threats under its existing policy; remediation is not automatically reversible. No hidden elevation or policy changes."
                               Foreground="{DynamicResource TextSecondary}" />
                    <WrapPanel Margin="0,0,0,4">
                        <Button Style="{DynamicResource PrimaryButton}"
                                Content="Quick scan…"
                                AutomationProperties.Name="Start confirmed Defender quick scan"
                                Command="{Binding QuickScanCommand}"
                                IsEnabled="{Binding CanScan}"
                                Padding="16,9" Margin="0,0,10,10" />
                        <Button Content="Full scan…"
                                AutomationProperties.Name="Start confirmed Defender full scan"
                                Command="{Binding FullScanCommand}"
                                IsEnabled="{Binding CanScan}"
                                Padding="14,9" Margin="0,0,10,10" />
                        <Button Content="Refresh scan lifecycle"
                                AutomationProperties.Name="Refresh Defender scan lifecycle"
                                Command="{Binding MonitorCommand}"
                                IsEnabled="{Binding CanMonitor}"
                                Padding="14,9" Margin="0,0,10,10" />
                        <Button Content="Stop monitoring"
                                AutomationProperties.Name="Stop monitoring Defender scan"
                                Command="{Binding StopMonitoringCommand}"
                                IsEnabled="{Binding ActionBusy}"
                                Padding="14,9" Margin="0,0,10,10" />
                    </WrapPanel>
                    <TextBlock Text="{Binding ScanStatus}" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="Leaving this page or stopping monitoring does NOT cancel a scan. No percentage or ETA is invented. Unknown outcomes block another request in this session. Safe mode blocks all scan starts."
                               Foreground="{DynamicResource TextSecondary}" />
                    <Button Content="Read detection history"
                            AutomationProperties.Name="Read Defender detection history"
                            Command="{Binding ReadDetectionsCommand}"
                            HorizontalAlignment="Left"
                            Padding="14,9" Margin="0,0,0,10" />
                    <TextBlock Text="{Binding Detections}" />
                    <Button Content="Open Windows Security…"
                            Command="{Binding OpenSecurityCommand}"
                            IsEnabled="{Binding CanOpenSecurity}"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="Open Windows Security after confirmation"
                            Padding="14,9" Margin="0,0,0,10" />
                    <TextBlock Text="Remediation handoff: Windows Security → Virus &amp; threat protection → Protection history. Review names, affected items, quarantine and supported actions there. WinCare does not remove files or provide in-app quarantine restore. Safe mode disables this handoff; open Windows Security manually from Start."
                               Foreground="{DynamicResource TextSecondary}" Margin="0" />
                </StackPanel>
            </Border>

            <!-- ══ MALWARE PERSISTENCE & HIJACK AUDIT (AUTORUNS + ADWCLEANER STYLE) ══ -->
            <Border Style="{DynamicResource Card}" Padding="20" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Malware Persistence &amp; Hijack Audit (Read-Only)" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Text="Checks the hiding spots adware, browser hijackers, and persistent trojans target most: drivers\etc\hosts domain redirects, WinINET Proxy / PAC traffic interception, and Run / RunOnce / Startup scripts launching from %TEMP%, Downloads, or encoded PowerShell / LOLBins."
                               Foreground="{DynamicResource TextSecondary}" />
                    <WrapPanel Margin="0,0,0,6">
                        <Button Style="{DynamicResource PrimaryButton}"
                                Content="Scan Persistence &amp; Hijack Vectors"
                                AutomationProperties.Name="Scan malware persistence and hijack vectors"
                                Command="{Binding RunPersistenceAuditCommand}"
                                IsEnabled="{Binding IsAuditing, Converter={x:Static vm:InverseBooleanConverter.Instance}}"
                                Padding="16,9" Margin="0,0,10,10" />
                        <Button Content="Review Startup Apps"
                                AutomationProperties.Name="Open Startup Application Manager"
                                Command="{Binding OpenStartupFromAuditCommand}"
                                Padding="14,9" Margin="0,0,10,10" />
                        <Button Content="Copy Audit Summary"
                                AutomationProperties.Name="Copy security audit report to clipboard"
                                Command="{Binding CopySecurityAuditReportCommand}"
                                Padding="14,9" Margin="0,0,10,10" />
                    </WrapPanel>
                    <TextBlock Text="{Binding AuditSummaryText}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
                    <ItemsControl ItemsSource="{Binding AuditFindings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{DynamicResource SurfaceHover}" CornerRadius="5"
                                                Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,10,0">
                                            <TextBlock Text="{Binding BadgeText}" FontSize="10.5" FontWeight="Bold"
                                                       FontFamily="{DynamicResource MonoFont}"
                                                       Foreground="{Binding Level, Converter={x:Static vm:SecurityLevelToBrushConverter.Instance}}"
                                                       Margin="0" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,0,3" />
                                            <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ══ SUSPICIOUS FILE INSPECTOR & TARGETED DEFENDER FILE SCAN ══ -->
            <Border Style="{DynamicResource Card}" Padding="20" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Suspicious File Inspector &amp; Targeted Defender Scan" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Text="Before opening an unfamiliar download, inspect its SHA-256 hash, Authenticode digital signature, and Mark-of-the-Web flag—or run a confirmed single-file Microsoft Defender scan directly."
                               Foreground="{DynamicResource TextSecondary}" />
                    <WrapPanel Margin="0,0,0,6">
                        <Button Style="{DynamicResource PrimaryButton}"
                                Content="Inspect File Signature &amp; SHA-256…"
                                AutomationProperties.Name="Inspect suspicious file signature and SHA-256 hash"
                                Command="{Binding InspectSuspiciousFileCommand}"
                                IsEnabled="{Binding IsInspectingFile, Converter={x:Static vm:InverseBooleanConverter.Instance}}"
                                Padding="16,9" Margin="0,0,10,10" />
                        <Button Content="Scan Inspected File with Defender…"
                                AutomationProperties.Name="Scan inspected file with Microsoft Defender"
                                Command="{Binding ScanSelectedFileWithDefenderCommand}"
                                IsEnabled="{Binding CanScanSelectedFile}"
                                Padding="14,9" Margin="0,0,10,10" />
                    </WrapPanel>
                    <Border Background="#0F172A" CornerRadius="8" Padding="14,10">
                        <TextBlock Text="{Binding FileTriageSummary}"
                                   FontFamily="{DynamicResource MonoFont}" FontSize="11.5"
                                   Foreground="#5EEAD4" Margin="0"
                                   AutomationProperties.LiveSetting="Polite" />
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
