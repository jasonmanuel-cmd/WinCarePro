<UserControl x:Class="WinCareDesktop.Views.HistoryLogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WinCareDesktop.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">
    <Grid Margin="0,0,10,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="240" />
        </Grid.RowDefinitions>

        <!-- ══ UNDO HISTORY SECTION ══════════════════════════════════ -->
        <Border Grid.Row="0" Style="{DynamicResource Card}" Padding="18" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Undo Transaction History" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,2" />
                    <TextBlock Text="Every action taken by WinCare Pro is logged here. Reversible actions can be restored with a single click."
                               FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                </StackPanel>

                <!-- Transactions List -->
                <ListBox Grid.Row="1" ItemsSource="{Binding UndoHistory}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,2" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="14,10"
                                                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Hairline}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHover}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>

                                <!-- Time -->
                                <Border Grid.Column="0" Background="{DynamicResource SurfaceHover}" CornerRadius="4"
                                        Padding="8,4" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Time, StringFormat={}{0:HH:mm:ss}}"
                                               FontFamily="{DynamicResource MonoFont}" FontSize="11"
                                               Foreground="{DynamicResource TextSecondary}" />
                                </Border>

                                <!-- Title & Description -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                               Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock Text="{Binding Description}" FontSize="11"
                                               Foreground="{DynamicResource TextTertiary}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- Space Reclaimed / Score -->
                                <TextBlock Grid.Column="2" Text="{Binding ReclaimedGb, StringFormat={}+{0:F2} GB Reclaimed}"
                                           VerticalAlignment="Center" HorizontalAlignment="Left"
                                           FontFamily="{DynamicResource MonoFont}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Primary}" />

                                <!-- Rollback Button -->
                                <Button Grid.Column="3" Content="↩ Rollback"
                                        Command="{Binding DataContext.RollbackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding Reversable}"
                                        Padding="10,6" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ══ SPLITTER / LABEL ══════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="0,0,0,6">
            <TextBlock Text="Live System Event Log" FontWeight="SemiBold" FontSize="13"
                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
            <Button Content="Clear Logs" Command="{Binding ClearLogsCommand}"
                    HorizontalAlignment="Right" Padding="10,4" />
        </Grid>

        <!-- ══ LIVE SYSTEM LOG VIEWER ════════════════════════════════ -->
        <Border Grid.Row="2" Style="{DynamicResource Card}" Background="#0F172A" Padding="14">
            <ListBox ItemsSource="{Binding Logs}" Background="Transparent" BorderThickness="0"
                     FontFamily="{DynamicResource MonoFont}" FontSize="11" Foreground="#38BDF8">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0,2" />
                        <Setter Property="Focusable" Value="False" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
