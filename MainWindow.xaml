<Window x:Class="WinCareDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WinCareDesktop.ViewModels"
        xmlns:views="clr-namespace:WinCareDesktop.Views"
        Title="WinCare Pro — System Optimizer &amp; Health Suite"
        Height="760" Width="1180"
        MinHeight="650" MinWidth="980"
        Background="{DynamicResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource SansFont}"
        TextOptions.TextFormattingMode="Ideal"
        Foreground="{DynamicResource TextPrimary}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ── ViewModel to View DataTemplates ─────────────────────── -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DiskAnalyzerViewModel}">
                <views:DiskAnalyzerView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:StartupManagerViewModel}">
                <views:StartupManagerView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AppUninstallViewModel}">
                <views:AppUninstallView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PrivacyViewModel}">
                <views:PrivacyView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:NetworkMonitorViewModel}">
                <views:NetworkMonitorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SchedulerViewModel}">
                <views:SchedulerView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:HistoryLogsViewModel}">
                <views:HistoryLogsView />
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{DynamicResource BgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ══ LEFT NAVIGATION SIDEBAR ═══════════════════════════════ -->
        <Border x:Name="Sidebar" Grid.Column="0" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Hairline}" BorderThickness="0,0,1,0">
            <Grid Margin="16,20,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,24">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="8"
                                    Background="{DynamicResource PrimaryLight}" Margin="0,0,10,0">
                                <TextBlock Text="⚡" FontSize="18" Foreground="{DynamicResource Primary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="WinCare Pro" FontSize="16" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="SYSTEM OPTIMIZER" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextTertiary}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Pro Badge -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                Background="{DynamicResource PrimaryLight}" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="v2.0 PRO" FontSize="9" FontWeight="Bold"
                                       Foreground="{DynamicResource Primary}" />
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- Navigation Menu Items -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding NavigationItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="10,8" Margin="0,0,0,4"
                                        Background="Transparent" BorderThickness="0">
                                    <Border CornerRadius="8" Padding="8,6"
                                            Background="{Binding IsSelected, Converter={x:Static vm:BooleanToPrimaryLightBrushConverter.Instance}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="15"
                                                       VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                                           Foreground="{DynamicResource TextPrimary}" />
                                                <TextBlock Text="{Binding Description}" FontSize="10"
                                                           Foreground="{DynamicResource TextTertiary}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Sidebar Footer Status -->
                <Border Grid.Row="2" Background="{DynamicResource SurfaceHover}" CornerRadius="8"
                        Padding="12,10" Margin="0,12,0,0" BorderBrush="{DynamicResource Hairline}" BorderThickness="1">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Status: 100% Offline" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource Success}" />
                            <TextBlock Text="Zero background telemetry" FontSize="10"
                                       Foreground="{DynamicResource TextTertiary}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ══ MAIN CONTENT COLUMN ═══════════════════════════════════ -->
        <Grid x:Name="MainColumn" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0" Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Hairline}" BorderThickness="0,0,0,1"
                    Padding="28,16,28,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Title & Subtitle of Selected View -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentView.Title}" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding CurrentView.Subtitle}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}" />
                    </StackPanel>

                    <!-- Header Telemetry Pills -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- RAM Pill -->
                        <Border Background="{DynamicResource SurfaceHover}" CornerRadius="6"
                                Padding="10,6" Margin="0,0,8,0" BorderBrush="{DynamicResource Hairline}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="RAM: " FontSize="11" Foreground="{DynamicResource TextTertiary}" />
                                <TextBlock Text="{Binding RamPercent, StringFormat={}{0:F0}%}" FontSize="11" FontWeight="Bold"
                                           FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource Primary}" />
                            </StackPanel>
                        </Border>

                        <!-- Disk Free Pill -->
                        <Border Background="{DynamicResource SurfaceHover}" CornerRadius="6"
                                Padding="10,6" Margin="0,0,8,0" BorderBrush="{DynamicResource Hairline}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Free: " FontSize="11" Foreground="{DynamicResource TextTertiary}" />
                                <TextBlock Text="{Binding FreeStorageGb, StringFormat={}{0:F0} GB}" FontSize="11" FontWeight="Bold"
                                           FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource Primary}" />
                            </StackPanel>
                        </Border>

                        <!-- Score Pill -->
                        <Border Background="{DynamicResource PrimaryLight}" CornerRadius="6"
                                Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Health: " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Primary}" />
                                <TextBlock Text="{Binding Score, StringFormat={}{0:F0}%}" FontSize="11" FontWeight="Bold"
                                           FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource Primary}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Dynamic Subview Display -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}" Margin="24,20,24,0" />
        </Grid>

        <!-- Legacy Overlay compatibility hook for tests -->
        <Border x:Name="SubScreenOverlay" Visibility="Collapsed" />
    </Grid>
</Window>
