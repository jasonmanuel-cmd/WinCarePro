<Window x:Class="WinCareDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WinCareDesktop.ViewModels"
        xmlns:views="clr-namespace:WinCareDesktop.Views"
        Title="WinCare Pro — System Flight Deck &amp; Health Suite"
        Height="760" Width="1180"
        MinHeight="650" MinWidth="980"
        Background="{DynamicResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource SansFont}"
        TextOptions.TextFormattingMode="Ideal"
        Foreground="{DynamicResource TextPrimary}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ── ViewModel to View DataTemplates ─────────────────────── -->
            <DataTemplate DataType="{x:Type vm:MemoryViewModel}"><views:MemoryView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:DefenderViewModel}"><views:DefenderView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:OptionsViewModel}"><views:OptionsView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DiskAnalyzerViewModel}">
                <views:DiskAnalyzerView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:StartupManagerViewModel}">
                <views:StartupManagerView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AppUninstallViewModel}">
                <views:AppUninstallView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PrivacyViewModel}">
                <views:PrivacyView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:NetworkMonitorViewModel}">
                <views:NetworkMonitorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SchedulerViewModel}">
                <views:SchedulerView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:HistoryLogsViewModel}">
                <views:HistoryLogsView />
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{DynamicResource BgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="244" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ══ LEFT COMMAND BRIDGE SIDEBAR (FLIGHT-DECK OBSIDIAN) ═══ -->
        <Border x:Name="Sidebar" Grid.Column="0"
                BorderBrush="{DynamicResource FlightDeckBorder}" BorderThickness="0,0,1,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0B1120" Offset="0.0" />
                    <GradientStop Color="#0F172A" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid Margin="14,18,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Grid.Row="0" Margin="2,0,2,14">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="8" Margin="0,0,10,0"
                                    BorderBrush="#402DD4BF" BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="{StaticResource PrimaryBrightColor}" Offset="0.0" />
                                        <GradientStop Color="{StaticResource PrimaryColor}" Offset="0.5" />
                                        <GradientStop Color="{StaticResource PrimaryDeepColor}" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Path Width="22" Height="22" Stretch="Uniform" Fill="White"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="F0 M 12,3.2 L 19.2,6 L 19.2,11.4 C 19.2,16 16.1,19.6 12,21 C 7.9,19.6 4.8,16 4.8,11.4 L 4.8,6 Z M 13.4,6.2 L 8.6,12.6 L 11.5,12.6 L 10.6,17.8 L 15.4,11.4 L 12.5,11.4 Z" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="WinCare Pro" FontSize="15.5" FontWeight="Bold"
                                           Foreground="{DynamicResource FlightDeckText}" />
                                <TextBlock Text="FLIGHT DECK // OPT" FontSize="8.5" FontWeight="SemiBold"
                                           FontFamily="{DynamicResource MonoFont}"
                                           Foreground="{DynamicResource FlightDeckCyan}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Edition Capsule -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                Background="#132E35" BorderBrush="#14B8A6" BorderThickness="1"
                                CornerRadius="5" Padding="6,2">
                            <TextBlock Text="{Binding OptionsVM.EditionBadge}" FontSize="8.5" FontWeight="Bold"
                                       FontFamily="{DynamicResource MonoFont}"
                                       Foreground="{DynamicResource FlightDeckCyan}" />
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- Navigation Menu Items -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding NavigationItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="{Binding Title}"
                                        AutomationProperties.HelpText="{Binding Description}"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="0" Margin="0,0,0,2"
                                        Background="Transparent" BorderThickness="0">
                                    <Border CornerRadius="7" Padding="10,5"
                                            Background="{Binding IsSelected, Converter={x:Static vm:BooleanToFlightNavBgConverter.Instance}}"
                                            BorderBrush="{Binding IsSelected, Converter={x:Static vm:BooleanToFlightNavBorderConverter.Instance}}"
                                            BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="14"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       Foreground="{Binding IsSelected, Converter={x:Static vm:BooleanToFlightNavIconConverter.Instance}}"
                                                       VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5"
                                                           Foreground="{Binding IsSelected, Converter={x:Static vm:BooleanToFlightNavTitleConverter.Instance}}" />
                                                <TextBlock Text="{Binding Description}" FontSize="9.5"
                                                           Foreground="{DynamicResource FlightDeckMuted}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Sidebar Telemetry Air-Gap Pod -->
                <Border Grid.Row="2" Background="#111C2E" CornerRadius="8"
                        Padding="11,9" Margin="0,10,0,0" BorderBrush="#1E293B" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,9,0" />
                        <StackPanel>
                            <TextBlock Text="AIR-GAPPED // OFFLINE" FontSize="10" FontWeight="Bold"
                                       FontFamily="{DynamicResource MonoFont}"
                                       Foreground="#34D399" />
                            <TextBlock Text="Zero background telemetry" FontSize="9.5"
                                       Foreground="{DynamicResource FlightDeckMuted}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ══ MAIN CONTENT COLUMN ═══════════════════════════════════ -->
        <Grid x:Name="MainColumn" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Flight-Deck Telemetry HUD Bar -->
            <Border Grid.Row="0" Background="{DynamicResource FlightDeckSurface}"
                    BorderBrush="{DynamicResource FlightDeckBorder}" BorderThickness="0,0,0,1"
                    Padding="26,14,26,13">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Title & Subtitle of Selected View -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding CurrentView.Title}" FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource FlightDeckText}" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding CurrentView.Subtitle}" FontSize="11.5"
                                   Foreground="{DynamicResource FlightDeckMuted}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Header HUD Telemetry Pods -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- RAM Pod -->
                        <Border Background="{DynamicResource FlightDeckPod}" CornerRadius="6"
                                Padding="10,6" Margin="0,0,8,0" BorderBrush="#293548" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="MEM // " FontSize="10.5" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource FlightDeckMuted}" />
                                <TextBlock Text="{Binding RamUsageText}" FontSize="11" FontWeight="Bold"
                                           FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource FlightDeckCyan}" />
                            </StackPanel>
                        </Border>

                        <!-- Disk Free Pod -->
                        <Border Background="{DynamicResource FlightDeckPod}" CornerRadius="6"
                                Padding="10,6" Margin="0,0,8,0" BorderBrush="#293548" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="FREE // " FontSize="10.5" FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource FlightDeckMuted}" />
                                <TextBlock Text="{Binding FreeStorageGb, StringFormat={}{0:F0} GB}" FontSize="11" FontWeight="Bold"
                                           FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource FlightDeckCyan}" />
                            </StackPanel>
                        </Border>

                        <!-- Health Index Pod -->
                        <Border Background="#132E35" BorderBrush="#14B8A6" BorderThickness="1"
                                CornerRadius="6" Padding="11,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="INDEX // " FontSize="10.5" FontWeight="SemiBold"
                                           FontFamily="{DynamicResource MonoFont}" Foreground="#99F6E4" />
                                <TextBlock Text="{Binding ScoreDisplay}" FontSize="11" FontWeight="Bold"
                                           FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource FlightDeckCyan}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Dynamic Subview Display -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}" Margin="24,20,24,0" />
        </Grid>

        <!-- Legacy Overlay compatibility hook for tests -->
        <Border x:Name="SubScreenOverlay" Visibility="Collapsed" />
    </Grid>
</Window>
