<Window x:Class="WinCarePro.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="WinCare Pro" Width="1120" Height="720" MinWidth="900" MinHeight="600"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        automation:AutomationProperties.Name="WinCare Pro main window">
  <Window.InputBindings>
    <KeyBinding Key="D" Modifiers="Control" Command="{Binding DashboardCommand}"/>
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding ScanCommand}"/>
  </Window.InputBindings>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#101722" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="WINCARE PRO" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
          <TextBlock Text="SYSTEM CARE CENTER" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,28"/>
          <Button Style="{StaticResource NavButton}" Content="Dashboard" Click="ShowDashboard" automation:AutomationProperties.Name="Dashboard"/>
          <Button Style="{StaticResource NavButton}" Content="System Health" Click="OpenLegacy" Tag="System Health" automation:AutomationProperties.Name="System Health"/>
          <Button Style="{StaticResource NavButton}" Content="Processes &amp; Cleanup" Click="OpenLegacy" Tag="Processes and Cleanup" automation:AutomationProperties.Name="Processes and Cleanup"/>
          <Button Style="{StaticResource NavButton}" Content="Privacy &amp; Network" Click="OpenLegacy" Tag="Privacy and Network" automation:AutomationProperties.Name="Privacy and Network"/>
          <Button Style="{StaticResource NavButton}" Content="Repairs &amp; Recovery" Click="OpenLegacy" Tag="Repairs and Recovery" automation:AutomationProperties.Name="Repairs and Recovery"/>
          <Button Style="{StaticResource NavButton}" Content="Settings &amp; License" Click="OpenLegacy" Tag="Settings and License" automation:AutomationProperties.Name="Settings and License"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <TextBlock Text="Accessible interface preview" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
          <TextBlock Text="v1.3.0" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="42,34">
        <DockPanel>
          <StackPanel>
            <TextBlock Text="Good system care starts here." FontSize="30" FontWeight="SemiBold"/>
            <TextBlock Text="Review first. Apply only the changes you approve." Foreground="{DynamicResource MutedBrush}" FontSize="15" Margin="0,7,0,0"/>
          </StackPanel>
          <Border DockPanel.Dock="Right" Background="#123044" CornerRadius="16" Padding="14,7" VerticalAlignment="Top">
            <TextBlock Text="●  READY" Foreground="#7DD3FC" FontWeight="Bold"/>
          </Border>
        </DockPanel>

        <UniformGrid Columns="3" Margin="0,34,0,24">
          <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="22" Margin="0,0,12,0">
            <StackPanel><TextBlock Text="SYSTEM STATUS" Foreground="{DynamicResource MutedBrush}" FontSize="12"/><TextBlock Text="Protected" FontSize="25" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel>
          </Border>
          <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="22" Margin="6,0">
            <StackPanel><TextBlock Text="CLEANUP MODE" Foreground="{DynamicResource MutedBrush}" FontSize="12"/><TextBlock Text="Review-first" FontSize="25" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel>
          </Border>
          <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="22" Margin="12,0,0,0">
            <StackPanel><TextBlock Text="UPDATE CHANNEL" Foreground="{DynamicResource MutedBrush}" FontSize="12"/><TextBlock Text="Secure" FontSize="25" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel>
          </Border>
        </UniformGrid>

        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="26">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Run a guided system review" FontSize="20" FontWeight="SemiBold"/>
              <TextBlock Text="The current production engine opens with every repair gated by a preview and confirmation."
                         Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" MaxWidth="570" Margin="0,8,25,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Open full WinCare Pro" Click="OpenLegacy"
                    automation:AutomationProperties.Name="Open full WinCare Pro"/>
          </Grid>
        </Border>
        <TextBlock x:Name="StatusText" Text="Ready. Press Ctrl+D for dashboard or Ctrl+S to open the full scanner."
                   Foreground="{DynamicResource MutedBrush}" Margin="0,22,0,0" automation:AutomationProperties.LiveSetting="Polite"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
